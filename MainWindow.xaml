<Window x:Class="Market.MainWindow" WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Market"
        mc:Ignorable="d"
        Title="Вход в систему" Height="399" Width="600" MinWidth="600" MinHeight="400" MaxWidth="600" MaxHeight="400" Icon="/img/logo.ico" Background="#FFC9F3F7">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="0,-9,0,9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Вход в систему" HorizontalAlignment="Center" VerticalAlignment="Top" Height="39" Width="178" FontSize="24" Margin="0,92,0,0"/>

        <TextBox x:Name="login" HorizontalAlignment="Left" Margin="212,175,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="170" TextChanged="login_TextChanged" Height="20"/>
        <Label Content="Логин или Email" HorizontalAlignment="Left" Margin="230,151,0,0" VerticalAlignment="Top" Height="24"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="230,199,0,0" VerticalAlignment="Top" Height="24"/>
        <PasswordBox x:Name="password" HorizontalAlignment="Left" Margin="212,224,0,0" VerticalAlignment="Top" Width="170" Height="20"/>
        <Button x:Name="enter_btn" Content="Войти" HorizontalAlignment="Left" Margin="248,254,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.161,0.283" Click="enter_btn_Click" Width="81" Height="22"/>
        <TextBlock x:Name="login_error" HorizontalAlignment="Center" Margin="0,281,0,0" VerticalAlignment="Top"
                   Width="476" Height="35" TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="14" Foreground="Red"/>
        <TextBlock x:Name="forgot_password" Text="Забыли пароль?" 
           HorizontalAlignment="Center" Margin="0,318,0,0" VerticalAlignment="Top" 
           FontSize="14" Cursor="Hand" MouseDown="forgot_password_MouseDown"
           TextDecorations="Underline">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#005A9C"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#003F6C"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock x:Name="registration" Text="Регистрация" 
            HorizontalAlignment="Center" Margin="0,337,0,0" VerticalAlignment="Top" 
            FontSize="14" Cursor="Hand" MouseDown="registration_MouseDown"
            TextDecorations="Underline">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="#005A9C"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#003F6C"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
