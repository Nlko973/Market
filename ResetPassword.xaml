<Window x:Class="Market.ResetPassword"
        WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Market"
        mc:Ignorable="d"
                Title="Сброс пароля"  MinWidth="500" MinHeight="280" Icon="/img/logo.ico" Background="#FFC9F3F7" MaxWidth="500" MaxHeight="280">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <PasswordBox x:Name="pass_input" HorizontalAlignment="Center" Margin="0,37,0,0" VerticalAlignment="Top" Width="240"/>
        <Label Content="Пароль" HorizontalAlignment="Center" Margin="0,12,0,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="pass_confirm_input" HorizontalAlignment="Center" Margin="0,82,0,0" VerticalAlignment="Top" Width="240"/>
        <Label Content="Подтверждение пароля" HorizontalAlignment="Center" Margin="0,55,0,0" VerticalAlignment="Top"/>
        <Button x:Name="change_password_btn" Content="Сменить пароль" HorizontalAlignment="Center" Margin="0,142,0,0" VerticalAlignment="Top" Height="30" Width="230" Click="change_password_btn_Click"/>
        <Button x:Name="close_window_btn" Content="Закрыть окно" HorizontalAlignment="Center" Margin="0,185,0,0" VerticalAlignment="Top" Click="close_window_btn_Click" Height="25" Width="116"/>
        <Label x:Name="message" Content="" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Margin="0,100,0,0" VerticalAlignment="Top" FontSize="14" Foreground="Red" Width="415" Height="32"/>

    </Grid>
</Window>
