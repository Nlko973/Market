<Window x:Class="Market.Categories"
        WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Market"
        mc:Ignorable="d"
        Title="Управление категориями" MinWidth="520" MinHeight="340" Icon="/img/logo.ico" Background="#FFC9F3F7" MaxWidth="520" MaxHeight="340">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Button x:Name="back_btn" Content="Назад" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Click="exit_btn_Click" Width="70"/>
        <ListBox x:Name="categories_list" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top" Width="260" Height="240" SelectionChanged="categories_list_SelectionChanged"/>
        <Label Content="Название категории" HorizontalAlignment="Left" Margin="300,50,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="category_name_input" HorizontalAlignment="Left" Margin="300,78,0,0" VerticalAlignment="Top" Width="180"/>
        <Button x:Name="add_btn" Content="Добавить" HorizontalAlignment="Left" Margin="300,120,0,0" VerticalAlignment="Top" Width="85" Click="add_btn_Click"/>
        <Button x:Name="save_btn" Content="Сохранить" HorizontalAlignment="Left" Margin="395,120,0,0" VerticalAlignment="Top" Width="85" Click="save_btn_Click" IsEnabled="False"/>
        <Button x:Name="delete_btn" Content="Удалить" HorizontalAlignment="Left" Margin="300,160,0,0" VerticalAlignment="Top" Width="180" Click="delete_btn_Click" IsEnabled="False"/>
        <Label x:Name="message" Content="" HorizontalAlignment="Left" Margin="300,198,0,0" VerticalAlignment="Top" Foreground="Red" Width="180" Height="70"/>
    </Grid>
</Window>
