<Window x:Class="Market.Main" WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Market"
        mc:Ignorable="d"
            Title="Главная" Height="450" Width="800" MinWidth="800" MaxWidth="800" MinHeight="450" MaxHeight="450" Icon="/img/logo.ico">
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="Fill" ImageSource="/img/Bg_main.png"/>
        </Grid.Background>
        <Rectangle HorizontalAlignment="Left" Height="52" Margin="10,10,0,0" VerticalAlignment="Top" Width="310" Fill="#FFCBC4C4" RadiusY="5" RadiusX="5"/>
        <Label x:Name="name" Content="ФИО" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <Label x:Name="role" Content="Роль" HorizontalAlignment="Left" Margin="10,36,0,0" VerticalAlignment="Top"/>
        <Button x:Name="exit_btn" Content="Выход" HorizontalAlignment="Left" Margin="713,23,0,0" VerticalAlignment="Top" Click="Button_Click" Height="31" Width="60" FontSize="18"/>
        <Button x:Name="product_management_btn" Content="Управление товарами" HorizontalAlignment="Left" Margin="32,352,0,0" VerticalAlignment="Top" Height="46" Width="293" Click="product_management_btn_Click"/>
        <Button x:Name="info_btn" Content="Инфо" HorizontalAlignment="Center" Margin="0,351,0,0" VerticalAlignment="Top" Height="46" Width="80" Click="info_btn_Click" RenderTransformOrigin="1.021,0.503"/>
        <Button x:Name="conducting_sales_btn" Content="Проведение продаж" HorizontalAlignment="Left" Margin="474,352,0,0" VerticalAlignment="Top" Height="46" Width="293" Click="conducting_sales_btn_Click"/>
    </Grid>
</Window>
