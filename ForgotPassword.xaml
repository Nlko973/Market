<Window x:Class="Market.ForgotPassword" 
        WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Market"
        mc:Ignorable="d"
        Title="Восстановление пароля" 
        Height="320" Width="450" 
        MinWidth="450" MinHeight="350" 
        MaxWidth="450" MaxHeight="350" 
        Icon="/img/logo.ico" 
        Background="#FFC9F3F7">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Label Content="Введите ваш Email или Логин:" HorizontalAlignment="Left" Margin="72,17,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="login_or_email_input" HorizontalAlignment="Center" Width="300" Height="30" Padding="5,5,0,0" Margin="0,53,0,217"/>
        <Button x:Name="reset_password_btn" Content="Отправить код на почту" HorizontalAlignment="Left" Margin="140,136,0,0" VerticalAlignment="Top" Width="164" Click="reset_password_btn_Click" Height="36"/>
        <TextBlock x:Name="status_message" HorizontalAlignment="Left" Margin="41,91,0,0" VerticalAlignment="Top" FontSize="14" Foreground="Red" TextWrapping="Wrap" Width="362" TextAlignment="Center"/>
        <Button x:Name="close_btn" Content="Закрыть" HorizontalAlignment="Right" Margin="0,263,66,0" VerticalAlignment="Top" Width="106" Click="close_btn_Click" Height="36"/>
        <Label x:Name="Код" Content="Код подтверждения почты" HorizontalAlignment="Left" Margin="143,181,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="code_input" HorizontalAlignment="Left" Margin="143,207,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="158"/>
        <Label x:Name="message" Content="" FontSize="14" HorizontalAlignment="Left" Margin="90,226,0,0" VerticalAlignment="Top" Width="264" Foreground="Red" HorizontalContentAlignment="Center"
       VerticalContentAlignment="Center" Height="32"/>
        <Button x:Name="enter_code_btn" Content="Сбросить пароль" HorizontalAlignment="Right" Margin="0,263,225,0" VerticalAlignment="Top" Width="170" Height="36" Click="enter_code_btn_Click"/>
    </Grid>
</Window>