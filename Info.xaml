<Window x:Class="Market.Info" WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Market"
        mc:Ignorable="d"
            Title="Инфо" Height="466" Width="521" MinWidth="521" MaxWidth="521" MinHeight="466" MaxHeight="466" Icon="/img/logo.ico" Background="#FFC9F3F7">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>
    <Grid>
        <Button x:Name="exit_btn" Content="Выход" HorizontalAlignment="Left" Margin="10,14,0,0" VerticalAlignment="Top" Click="exit_btn_Click"/>
        <Rectangle HorizontalAlignment="Left" Height="44" Margin="56,10,0,0" VerticalAlignment="Top" Width="371" Fill="#FFD2D2D2" RadiusX="5" RadiusY="5"/>
        <Label Content="Выбор&#xD;&#xA;периода" HorizontalAlignment="Left" Margin="56,9,0,0" VerticalAlignment="Top"/>
        <Label Content="Начало периода" HorizontalAlignment="Left" Margin="139,30,0,0" VerticalAlignment="Top"/>
        <Label Content="Конец периода" HorizontalAlignment="Left" Margin="280,30,0,0" VerticalAlignment="Top"/>
        <DatePicker x:Name="start_period" HorizontalAlignment="Left" Margin="142,12,0,0" VerticalAlignment="Top" BorderBrush="{x:Null}"/>
        <DatePicker x:Name="end_period" HorizontalAlignment="Left" Margin="283,12,0,0" VerticalAlignment="Top" BorderBrush="{x:Null}"/>
        <Button x:Name="apply_btn" Content="Применить" HorizontalAlignment="Left" Margin="432,10,0,0" VerticalAlignment="Top" Click="apply_btn_Click"/>
        <Button x:Name="export_btn" Content="Отчёт" HorizontalAlignment="Left" Margin="432,35,0,0" VerticalAlignment="Top" Click="export_btn_Click" IsEnabled="False" Width="66"/>
        <ListBox x:Name="data_list" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,65,10,180"/>
        <Rectangle HorizontalAlignment="Center" Height="145" Margin="10,275,10,0" VerticalAlignment="Top" Width="481" Fill="#FFD2D2D2" RadiusX="5" RadiusY="5"/>
        <Label x:Name="period_output" Content="Тут будут данные за выбранный период" HorizontalAlignment="Left" Margin="20,273,0,0" VerticalAlignment="Top"/>
        <Label x:Name="day_output" Content="День" HorizontalAlignment="Left" Margin="20,301,0,0" VerticalAlignment="Top"/>
        <Label x:Name="week_output" Content="Неделя" HorizontalAlignment="Left" Margin="20,332,0,0" VerticalAlignment="Top"/>
        <Label x:Name="month_output" Content="Месяц" HorizontalAlignment="Left" Margin="20,363,0,0" VerticalAlignment="Top"/>
        <Label x:Name="total_output" Content="Всего" HorizontalAlignment="Left" Margin="20,394,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
