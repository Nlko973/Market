<Window x:Name="registration" x:Class="Market.Registration"
        WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Market"
        mc:Ignorable="d"
        Title="Регистрация магазина"  MinWidth="700" MinHeight="440" Icon="/img/logo.ico" Background="#FFC9F3F7" MaxWidth="700" MaxHeight="440">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <TextBox x:Name="store_name_input" HorizontalAlignment="Center" Margin="0,33,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="240"/>
        <Label x:Name="___Без_имени_" Content="ФИО" HorizontalAlignment="Center" Margin="0,52,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="fio_input" HorizontalAlignment="Center" Margin="0,77,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="240"/>
        <Label x:Name="___Без_имени_1" Content="Логин" HorizontalAlignment="Center" Margin="0,95,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="login_input" HorizontalAlignment="Center" Margin="0,123,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="240"/>
        <Label x:Name="___Без_имени_1_Копировать" Content="Email" HorizontalAlignment="Center" Margin="0,143,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="email_input" HorizontalAlignment="Center" Margin="0,171,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="240"/>
        <PasswordBox x:Name="pass_input" HorizontalAlignment="Center" Margin="0,212,0,0" VerticalAlignment="Top" Width="240"/>
        <Label Content="Пароль" HorizontalAlignment="Center" Margin="0,187,0,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="pass_confirm_input" HorizontalAlignment="Center" Margin="0,257,0,0" VerticalAlignment="Top" Width="240"/>
        <Label Content="Подтверждение пароля" HorizontalAlignment="Center" Margin="0,230,0,0" VerticalAlignment="Top"/>
        <Label x:Name="Название_магазина" Content="Название магазина" HorizontalAlignment="Center" Margin="0,8,0,0" VerticalAlignment="Top"/>
        <Button x:Name="registration_btn" Content="Зарегистрировать магазин" HorizontalAlignment="Center" Margin="0,297,0,0" VerticalAlignment="Top" Click="registration_btn_Click" Height="30" Width="230"/>
        <Button x:Name="close_window_btn" Content="Закрыть окно" HorizontalAlignment="Center" Margin="0,340,0,0" VerticalAlignment="Top" Click="close_window_btn_Click" Height="25" Width="116"/>
        <Label x:Name="message" Content="" FontSize="14" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Margin="0,365,0,0" Foreground="Red" VerticalAlignment="Top" Width="611"/>
    </Grid>
</Window>
