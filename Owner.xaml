<Window x:Class="Market.Owner" WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Market"
        mc:Ignorable="d"
           Title="Панель управления"  MinWidth="800" MinHeight="473" Icon="/img/logo.ico" Background="#FFC9F3F7" MaxWidth="800" MaxHeight="473">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Button x:Name="exit_btn" Content="Выход" HorizontalAlignment="Left" Margin="30,23,0,0" VerticalAlignment="Top" Click="Button_Click" Height="31" Width="60" FontSize="18"/>
        <Rectangle HorizontalAlignment="Left" Height="53" Margin="636,34,0,0" VerticalAlignment="Top" Width="126" Fill="#FFD2D2D2" RadiusX="5" RadiusY="5"/>
        <RadioButton x:Name="btn_seller" Content="Продавец" HorizontalAlignment="Left" Margin="647,44,0,0" VerticalAlignment="Top" Checked="btn_seller_Checked" IsChecked="True"/>
        <RadioButton x:Name="btn_administrator" Content="Администратор" HorizontalAlignment="Left" Margin="647,64,0,0" VerticalAlignment="Top" Checked="btn_administrator_Checked"/>
        <ListBox x:Name="user_list" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="30,71,400,232" SelectionChanged="user_list_SelectionChanged"/>
        <Label x:Name="___Без_имени_" Content="ФИО" HorizontalAlignment="Left" Margin="476,119,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="fio_input" HorizontalAlignment="Left" Margin="477,144,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="239" TextChanged="fio_input_TextChanged"/>
        <Label x:Name="___Без_имени_1" Content="Логин" HorizontalAlignment="Left" Margin="476,162,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="login_input" HorizontalAlignment="Left" Margin="477,190,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="239" TextChanged="login_input_TextChanged"/>
        <Label x:Name="___Без_имени_1_Копировать" Content="Email" HorizontalAlignment="Left" Margin="475,210,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="email_input" HorizontalAlignment="Left" Margin="476,238,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="239" TextChanged="login_input_TextChanged"/>
        <PasswordBox x:Name="pass_input" HorizontalAlignment="Left" Margin="475,279,0,0" VerticalAlignment="Top" Width="239"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="476,254,0,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="pass_confirm_input" HorizontalAlignment="Left" Margin="475,324,0,0" VerticalAlignment="Top" Width="239"/>
        <Label Content="Подтверждение пароля" HorizontalAlignment="Left" Margin="476,297,0,0" VerticalAlignment="Top"/>
        <Button x:Name="remove_btn" Content="Удалить" HorizontalAlignment="Left" Margin="619,382,0,0" VerticalAlignment="Top" Click="remove_btn_Click"/>
        <Button x:Name="add_btn" Content="Добавить" HorizontalAlignment="Left" Margin="674,382,0,0" VerticalAlignment="Top" Click="add_btn_Click"/>
        <Rectangle HorizontalAlignment="Left" Height="107" Margin="26,243,0,0" VerticalAlignment="Top" Width="332" Fill="#FFD2D2D2" RadiusX="5" RadiusY="5"/>
        <Label Content="Данные пользователя" HorizontalAlignment="Left" Margin="30,240,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="get_fio" Content="ФИО" HorizontalAlignment="Left" Margin="33,262,0,0" VerticalAlignment="Top"/>
        <Label x:Name="get_email" Content="Email" HorizontalAlignment="Left" Margin="33,288,0,0" VerticalAlignment="Top"/>
        <Label x:Name="get_login" Content="Логин" HorizontalAlignment="Left" Margin="33,315,0,0" VerticalAlignment="Top"/>
        <Label x:Name="get_store_name" Content="Магазин" HorizontalAlignment="Left" Margin="101,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="get_user_name" Content="ФИО" HorizontalAlignment="Left" Margin="101,28,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>

