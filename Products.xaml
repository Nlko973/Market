<Window x:Class="Market.Products" WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Market"
        mc:Ignorable="d"
            Title="Управление товарами" Height="442" Width="605" MinWidth="605" MaxWidth="605" MinHeight="442" MaxHeight="442" Icon="/img/logo.ico" Background="#FFC9F3F7">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="0,0,0,-16">
        <Button x:Name="exit_btn" Content="Выход" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Click="exit_btn_Click"/>
        <TextBox x:Name="search" HorizontalAlignment="Left" Margin="107,11,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="235"/>
        <Label Content="Поиск" HorizontalAlignment="Left" Margin="58,5,0,0" VerticalAlignment="Top" Height="24"/>
        <Label Content="Введите название или штрих-код" HorizontalAlignment="Left" Margin="123,22,0,0" VerticalAlignment="Top"/>
        <Button x:Name="search_btn" Content="Поиск" HorizontalAlignment="Left" Margin="360,11,0,0" VerticalAlignment="Top" Width="40" Click="search_btn_Click"/>
        <Button x:Name="clear_btn" Content="Очистить" HorizontalAlignment="Left" Margin="404,11,0,0" VerticalAlignment="Top" Click="clear_btn_Click"/>
        <ListBox x:Name="products_list" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,50,263,196" SelectionChanged="products_list_SelectionChanged"/>
        <Button x:Name="remove_product_btn" Content="Удалить" HorizontalAlignment="Left" Margin="360,54,0,0" VerticalAlignment="Top" Width="56" Click="remove_product_btn_Click"/>
        <TextBox x:Name="input_product_name" HorizontalAlignment="Left" Margin="360,101,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="218"/>
        <Label Content="Добавление товара" HorizontalAlignment="Left" Margin="432,51,0,0" VerticalAlignment="Top"/>
        <Label Content="Изменение товара" HorizontalAlignment="Left" Margin="10,227,0,0" VerticalAlignment="Top"/>
        <Label Content="Название" HorizontalAlignment="Left" Margin="360,79,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="input_product_category" HorizontalAlignment="Left" Margin="360,137,0,0" VerticalAlignment="Top" Width="173"/>
        <Label Content="Категория" HorizontalAlignment="Left" Margin="360,115,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="input_product_barcode" HorizontalAlignment="Left" Margin="360,178,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="173"/>
        <Label Content="Штрих-код" HorizontalAlignment="Left" Margin="360,155,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="input_product_count" HorizontalAlignment="Left" Margin="360,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="89"/>
        <Label Content="Количество" HorizontalAlignment="Left" Margin="360,195,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="input_product_price" HorizontalAlignment="Left" Margin="360,259,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="75"/>
        <Label Content="Цена" HorizontalAlignment="Left" Margin="360,236,0,0" VerticalAlignment="Top"/>
        <Button x:Name="add_product_btn" Content="Добавить" HorizontalAlignment="Left" Margin="360,302,0,0" VerticalAlignment="Top" Click="add_product_btn_Click"/>
        <Rectangle HorizontalAlignment="Left" Height="141" Margin="10,252,0,0" VerticalAlignment="Top" Width="332" Fill="#FFD2D2D2" RadiusX="5" RadiusY="5"/>
        <Label Content="Название" HorizontalAlignment="Left" Margin="10,259,0,0" VerticalAlignment="Top"/>
        <Label Content="Категория" HorizontalAlignment="Left" Margin="10,285,0,0" VerticalAlignment="Top"/>
        <Label Content="Штрих-код" HorizontalAlignment="Left" Margin="10,311,0,0" VerticalAlignment="Top"/>
        <Label Content="Количество" HorizontalAlignment="Left" Margin="10,337,0,0" VerticalAlignment="Top"/>
        <Label Content="Цена" HorizontalAlignment="Left" Margin="10,362,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="product_name" HorizontalAlignment="Left" Margin="78,263,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="218"/>
        <ComboBox x:Name="product_category" HorizontalAlignment="Left" Margin="78,289,0,0" VerticalAlignment="Top" Width="173"/>
        <TextBox x:Name="product_barcode" HorizontalAlignment="Left" Margin="80,314,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="171"/>
        <TextBox x:Name="product_count" HorizontalAlignment="Left" Margin="84,341,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="89"/>
        <TextBox x:Name="product_price" HorizontalAlignment="Left" Margin="53,366,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="75"/>
        <Button x:Name="save_changes_btn" Content="Сохранить изменения" HorizontalAlignment="Left" Margin="360,337,0,0" VerticalAlignment="Top" Height="33" Width="142" Click="save_changes_btn_Click"/>
        <CheckBox x:Name="allow_changes" Content="Разрешить изменения" HorizontalAlignment="Left" Margin="360,381,0,0" VerticalAlignment="Top" Checked="allow_changes_Checked" Unchecked="allow_changes_Unchecked"/>
        <Button x:Name="category_btn" Content="Категории" HorizontalAlignment="Left" Margin="484,11,0,0" VerticalAlignment="Top" Click="category_clear_btn_Click" Width="102" Height="20"/>
    </Grid>
</Window>
