<Window x:Class="Market.ConfirmationRegistration"
        WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Market"
        mc:Ignorable="d"
            Title="Подтверждение почты для регистрации"  MinWidth="600" MinHeight="300" Icon="/img/logo.ico" Background="#FFC9F3F7" MaxWidth="600" MaxHeight="300">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Rectangle HorizontalAlignment="Center" Height="58" Margin="0,23,0,0" VerticalAlignment="Top" Width="476" Fill="#FFCBC4C4" RadiusY="5" RadiusX="5"/>
        <Label x:Name="description_label" Content="Код отправляется на почту автоматически. Введите его и подтвердите регистрацию." HorizontalAlignment="Center" Margin="0,39,0,0" VerticalAlignment="Top"/>
        <Label x:Name="Код" Content="Код подтверждения почты" HorizontalAlignment="Center" Margin="0,124,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="code_input" HorizontalAlignment="Center" Margin="0,150,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="158"/>
        <Button x:Name="enter_btn" Content="Зарегистрировать" HorizontalAlignment="Center" Margin="0,178,0,0" VerticalAlignment="Top" Click="enter_btn_Click" Height="30" Width="230"/>
        <Button x:Name="back_btn" Content="Выход" HorizontalAlignment="Center" Margin="0,225,0,0" VerticalAlignment="Top" Click="back_btn_Click" Height="27" Width="116"/>
        <Label x:Name="message" Content="" HorizontalAlignment="Center" Margin="0,82,0,0" VerticalAlignment="Top" FontSize="14" Width="430" Height="42" Foreground="Red" HorizontalContentAlignment="Center"/>

    </Grid>
</Window>
